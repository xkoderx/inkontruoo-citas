# Copia este archivo como .env (nunca subas el .env real a GitHub).
# Puerto de la API.
PORT=3001

# Secreto para firmar los tokens JWT del administrador.
# Cambia este valor por una frase larga y aleatoria en producción.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Cuenta del administrador (se crea sola al arrancar si no existe).
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contrasena
